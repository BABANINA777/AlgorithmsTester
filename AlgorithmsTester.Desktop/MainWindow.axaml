        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AlgorithmsTester.Desktop.MainWindow"
        Title="AlgorithmsTester.Desktop">
    <Grid >
        <!-- ЭКРАН 1: КАРТОЧКИ -->
        <Grid x:Name="CardsView" Grid.RowDefinitions="Auto, Auto, Auto">
            
        </Grid>
        
        <!-- ЭКРАН 2: ГРАФИК -->
        <Grid x:Name="ChartView" IsVisible="False">
            
        </Grid>
    </Grid>
</Window>
